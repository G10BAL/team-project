@startuml
!include diagram-style.iuml
!pragma layout smetana
skinparam classAttributeIconSize 0
hide circle
hide methods
class users <<table>> {
  id : INTEGER <<PK>>
  discord_id : TEXT <<unique>>
  pseudonym_id : TEXT <<unique>>
  participant_group : TEXT
  created_at : TEXT
}
class tracks <<table>> {
  id : INTEGER <<PK>>
  title : TEXT
  artist : TEXT [nullable]
  genre : TEXT [nullable]
  tags : TEXT [nullable]
  file_path : TEXT <<unique>>
  duration_seconds : INTEGER [nullable, > 0]
  created_at : TEXT
}
class listening_sessions <<table>> {
  id : INTEGER <<PK>>
  user_id : INTEGER <<FK>>
  track_id : INTEGER <<FK>>
  started_at : TEXT
  finished_at : TEXT [nullable]
  listened_seconds : INTEGER [>= 0]
  status : TEXT
}
class ratings <<table>> {
  id : INTEGER <<PK>>
  user_id : INTEGER <<FK>>
  track_id : INTEGER <<FK>>
  score : INTEGER [1..5]
  created_at : TEXT
  updated_at : TEXT
  {field} UNIQUE(user_id, track_id)
}
class favourites <<table>> {
  user_id : INTEGER <<PK, FK>>
  track_id : INTEGER <<PK, FK>>
  added_at : TEXT
}
class recommendation_lists <<table>> {
  id : INTEGER <<PK>>
  user_id : INTEGER <<FK>>
  algorithm : TEXT [baseline | tfidf]
  experiment_id : TEXT [nullable]
  created_at : TEXT
}
class recommendation_items <<table>> {
  id : INTEGER <<PK>>
  list_id : INTEGER <<FK>>
  track_id : INTEGER <<FK>>
  rank : INTEGER [>= 1]
  {field} UNIQUE(list_id, rank)
  {field} UNIQUE(list_id, track_id)
}
class v_experiment_export <<view>> {
  pseudonym_id
  participant_group
  algorithm
  experiment_id
  list_id
  track_id
  position
  rating [nullable]
  event_timestamp
}
users "1" -- "0..*" listening_sessions
tracks "1" -- "0..*" listening_sessions
users "1" -- "0..*" ratings
tracks "1" -- "0..*" ratings
users "1" -- "0..*" favourites
tracks "1" -- "0..*" favourites
users "1" -- "0..*" recommendation_lists
recommendation_lists "1" -- "0..*" recommendation_items
tracks "1" -- "0..*" recommendation_items
v_experiment_export ..> recommendation_items
v_experiment_export ..> recommendation_lists
v_experiment_export ..> users
v_experiment_export ..> ratings : LEFT JOIN (user, track)
@enduml
