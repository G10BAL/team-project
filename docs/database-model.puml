@startuml
!include diagram-style.iuml
!pragma layout smetana
skinparam classAttributeIconSize 0
hide circle
hide methods
class users <<таблиця>> {
  id : INTEGER <<PK>>
  discord_id : TEXT <<унікальне>>
  pseudonym_id : TEXT <<унікальне>>
  participant_group : TEXT
  created_at : TEXT
}
class tracks <<таблиця>> {
  id : INTEGER <<PK>>
  title : TEXT
  artist : TEXT [може бути NULL]
  genre : TEXT [може бути NULL]
  tags : TEXT [може бути NULL]
  file_path : TEXT <<унікальне>>
  duration_seconds : INTEGER [може бути NULL, > 0]
  created_at : TEXT
}
class listening_sessions <<таблиця>> {
  id : INTEGER <<PK>>
  user_id : INTEGER <<FK>>
  track_id : INTEGER <<FK>>
  started_at : TEXT
  finished_at : TEXT [може бути NULL]
  listened_seconds : INTEGER [>= 0]
  status : TEXT
}
class ratings <<таблиця>> {
  id : INTEGER <<PK>>
  user_id : INTEGER <<FK>>
  track_id : INTEGER <<FK>>
  score : INTEGER [1..5]
  created_at : TEXT
  updated_at : TEXT
  {field} UNIQUE(user_id, track_id)
}
class favourites <<таблиця>> {
  user_id : INTEGER <<PK, FK>>
  track_id : INTEGER <<PK, FK>>
  added_at : TEXT
}
class recommendation_lists <<таблиця>> {
  id : INTEGER <<PK>>
  user_id : INTEGER <<FK>>
  algorithm : TEXT [baseline | tfidf]
  experiment_id : TEXT [може бути NULL]
  created_at : TEXT
}
class recommendation_items <<таблиця>> {
  id : INTEGER <<PK>>
  list_id : INTEGER <<FK>>
  track_id : INTEGER <<FK>>
  rank : INTEGER [>= 1]
  {field} UNIQUE(list_id, rank)
  {field} UNIQUE(list_id, track_id)
}
class v_experiment_export <<подання>> {
  pseudonym_id
  participant_group
  algorithm
  experiment_id
  list_id
  track_id
  position
  rating [може бути NULL]
  event_timestamp
}
users "1" -- "0..*" listening_sessions
tracks "1" -- "0..*" listening_sessions
users "1" -- "0..*" ratings
tracks "1" -- "0..*" ratings
users "1" -- "0..*" favourites
tracks "1" -- "0..*" favourites
users "1" -- "0..*" recommendation_lists
recommendation_lists "1" -- "0..*" recommendation_items
tracks "1" -- "0..*" recommendation_items
v_experiment_export ..> recommendation_items
v_experiment_export ..> recommendation_lists
v_experiment_export ..> users
v_experiment_export ..> ratings : LEFT JOIN (user, track)
note bottom of listening_sessions
Проєкт схеми з PR № 26.
Один рядок — відтворення одного треку.
Окремі події прослуховування ще не виділено.
status: playing | finished | skipped
end note
note bottom of users
participant_group: participant | team
Для всіх зовнішніх ключів: ON DELETE CASCADE.
end note
legend bottom
PK — первинний ключ; FK — зовнішній ключ.
NULL — відсутнє значення; UNIQUE — обмеження унікальності.
1 — один запис; 0..* — нуль або більше записів.
endlegend
caption Рисунок 4 — Діаграма класів структури бази даних Resonance
@enduml
